# Railway에서는 DATABASE_URL을 Postgres 서비스의 참조 변수로 연결합니다.
DATABASE_URL=postgresql://postgres:password@localhost:5432/flying_cup

# 반드시 충분히 긴 무작위 문자열로 변경하세요.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# 최초 교사 계정
INITIAL_TEACHER_ID=teacher
INITIAL_TEACHER_PASSWORD=41234123

# 로컬 개발
PORT=3000

# Railway 내부 Postgres에서는 일반적으로 false로 두면 됩니다.
# 외부 SSL 연결을 쓰는 경우 true
DATABASE_SSL=false
